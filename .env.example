# Copy to .env for running the backend outside Docker (never commit .env).
# When using docker compose, these values are already set in docker-compose.yml.
DATABASE_URL=postgresql+psycopg://nutrientlog:nutrientlog@localhost:5432/nutrientlog

# Free key for USDA food search: https://fdc.nal.usda.gov/api-key-signup (leave empty to turn it off).
USDA_API_KEY=
# Open Food Facts (extra packaged foods and barcodes) needs no key. Set to false to turn it off.
# OPEN_FOOD_FACTS=true
# Only Open Food Facts products sold in this country (leave empty for all countries).
# OPEN_FOOD_FACTS_COUNTRY=united-states

