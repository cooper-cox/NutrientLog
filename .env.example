# Copy this file to a new file named .env (never commit .env; it is already in .gitignore).

# Password for the local database. Choose your own: letters and numbers only (it is placed in a
# web address). docker compose refuses to start without it. If you change it after the database
# already exists, run `docker compose down -v` once (this deletes the local test data).
POSTGRES_PASSWORD=choose-a-password-here

# Free key for USDA food search: https://fdc.nal.usda.gov/api-key-signup (leave empty to turn it off).
USDA_API_KEY=

# Only needed to run the backend outside Docker (docker compose builds this one for you):
# DATABASE_URL=postgresql+psycopg://nutrientlog:choose-a-password-here@localhost:5432/nutrientlog

# Open Food Facts (extra packaged foods and barcodes) needs no key. Set to false to turn it off.
# OPEN_FOOD_FACTS=true
# Only Open Food Facts products sold in this country (leave empty for all countries).
# OPEN_FOOD_FACTS_COUNTRY=united-states
